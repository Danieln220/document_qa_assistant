# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never put a real key in THIS file.

# Company name shown in the chat UI and in "I don't know" replies.
COMPANY_NAME=Ridgeline Equipment Rentals

# Folders (relative to the project root).
DOCUMENTS_DIR=documents
INDEX_DIR=index

# Local embedding model from Hugging Face (free, runs on your machine).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Which provider writes the answers: groq (default; 200k tokens/day) or gemini
# (fallback; only 20 requests/day per model). See docs/costs-and-limits.md.
LLM_PROVIDER=groq

# Google AI Studio (free): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier): create a key at https://console.groq.com -> API Keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# How hard the model thinks before answering: low (fastest) | medium | high
GROQ_REASONING_EFFORT=low

# Retrieval tuning: passages given to the LLM, and the minimum match score
# below which the assistant refuses without asking the LLM.
TOP_K=4
RELEVANCE_THRESHOLD=0.5

# The owner's screen at /admin: add or remove documents, and see what staff asked.
# LOG_QUESTIONS=false stops questions being recorded at all.
# ADMIN_PASSWORD protects the page; leave empty only on a personal machine.
LOG_QUESTIONS=true
ADMIN_PASSWORD=
MAX_UPLOAD_MB=40

# Telegram: token from @BotFather, and the chat IDs allowed to use the bot
# (comma-separated numbers). An empty list allows nobody.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
